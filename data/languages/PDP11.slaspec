define endian=little;
define alignment=2;

define space ram      type=ram_space      size=2 default; # would like to have 3, but errors...
define space register type=register_space size=2;


# R0–R7 (SP=R6, PC=R7)
define register offset=0x0000 size=2 [ R0 ];
define register offset=0x0002 size=2 [ R1 ];
define register offset=0x0004 size=2 [ R2 ];
define register offset=0x0006 size=2 [ R3 ];
define register offset=0x0008 size=2 [ R4 ];
define register offset=0x000A size=2 [ R5 ];
define register offset=0x000C size=2 [ SP ]; #R6 , stekas mazejantis
define register offset=0x000E size=2 [ PC ]; #R7
define register offset=0x0020 size=2 [ PS ]; # STATUS FLAGS & INT LEVEL





# Flag Register Contents (PS)
#
# b15:14    - Current mode: 00-kernel, 01-supervisor, 10-illegal, 11-user
# b13:b12   - Previous mode
# b11		- register set
# b10:b9	- unused
# b8   		- Reserved area
# b7        - (I) Interrupt prio 
# b6        - (I) Interrupt prio
# b5        - (I) Interrupt prio 
# b4        - (T) trace
# b3        - (S)(N) Sign flag
# b2        - (Z) Zero flag
# b1        - (O)(V) Overflow flag 
# b0        - (C) Carry flag

define bitrange
SPLevel=PS[5,3]

# U = PS[7,1]
# I = PS[6,1]
# D = PS[5,1]


# T = PS[4,1]

N = PS[3,1]
S = PS[3,1]
Z = PS[2,1]
V = PS[1,1]
O = PS[1,1]
C = PS[0,1]
;

######### CPU FLAG MACROS ###################
macro CHKNZ(a){N=(a & 0x8000)!=0;Z=(a==0);}
macro V_NZ(){V=C ^ N;}
macro ADD_FLAGS(ss,dd){ts=(ss & 0x8000)!=0;td=(dd & 0x8000)!=0;tr=(((ss+dd) & 0x8000)!=0);Z=((ss+dd)==0);V=((!(ts ^ td)) & (tr ^ td));C=((ts & td)|(ts ^ td) & !tr);}
macro SUB_FLAGS(ss,dd){ts=(ss & 0x8000)!=0;td=(dd & 0x8000)!=0;tr=(((ss-dd) & 0x8000)!=0);Z=((ss-dd)==0);V=((ts ^ td) & (!(tr ^ td)));C=((ts & !(td))|(!(ts ^ td) & tr));N=tr;}
macro CMP_FLAGS(ss,dd){ts=(ss & 0x8000)!=0;td=(dd & 0x8000)!=0;tr=(((ss-dd) & 0x8000)!=0);Z=(ss==dd);V=((ts ^ td) & (!(tr ^ td)));C=(((!ts) & td)|(!(ts ^ td) & tr));N=tr;}
macro FLZ(register){Z=(register==0);}
macro FLV(register){V=((register & 0xFFFF)==0xFFFF);}
macro FLN(register){N=(register & 0x8000)!=0;}

########## STACK MANAGMENT (decrementing stack) ##############
macro push(val) {SP = SP - 2;*:2 SP = val;}
macro pop(val)  {val = *:2 SP;SP = SP + 2;}

########## PC is R7, but ghidra ignores it. fix ##############
macro PCFIX(value, regfield,metod_d) {
if !(regfield==7 & (metod_d==0 | metod_d==4 | metod_d==5)) goto <exit>;
# PC=value;
 goto [value];
<exit> 
 }
#TOKENS:

# main opcode
define token word_1 (16)
	byte = (15,15)
	kodas = (6,15)
	metod = (3,5)
	regai =(0,2)
	
	op_h =(8,15)
	ac=(6,7)
	rell = (0,7) signed
	baitas = (0,7)
	eemt=(0,7)
	
	kodas_s = (12,15)
	met_s=(9,11)
	reg_s=(6,8)
	reg_ss=(6,8)
	reg_lo=(6,8)	
	
	met_d=(3,5)
	
	reg_d=(0,2)
	reg_dd=(0,2)

	
	nnn=(0,5)
	fpu=(3,15)
	
;


