####################### VARIANTAI adresacijos #############################################

# adresacijos metodai (mode)? arba
# 0 - registras Rn ; =R
# 1 - netiesioginis registras @Rn arba (Rn) - viduje registro reiksme; =peek(R)
# 2 - autoinkrementinis (Rn)+ ; =peek(R), R=R+1
# 3 - @(Rn)+
# 4 - -(Rn)
# 5 - @-(Rn)
# 6 - indeksinis X(Rn)
# 7 - @X(Rn)

# SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE SOURCE

# MODE0: Operand is in the register
# operand = Rn
OPS: reg_s" OK0a"			is met_s=0 & reg_ss=7 & reg_s{tmp:2 =  reg_s+2; export tmp;} # Tested in hardware: PC reg contains NEXT adr
OPS: reg_s" OK0b"			is met_s=0 & reg_ss!=7 & reg_s{tmp:2 =  reg_s; export tmp;}

# MODE1:(register deferred)
# Register contains the address of the operand
# EA = Rn
# operand = MEM[EA]

OPS: "("reg_s") OK1"		is met_s=1 & reg_s {tmp:2 =0; tmp=*:2 reg_s; export tmp;}

# MODE2: (autoincrement)
# EA = Rn
# operand = MEM[EA]
# Rn = Rn + (is_byte ? 1 : 2)
OPS: "("reg_s")+ OK2a"		is byte=1 & met_s=2 & reg_s {tmp:2=reg_s; reg_s=reg_s+1; export *:2 tmp; }
OPS: "("reg_s")+ OK2b"		is byte=0 & met_s=2 & reg_s {tmp:2=reg_s; reg_s=reg_s+2; export *:2 tmp; }
OPS: "#"imm16" OK2c"		is byte=0 & met_s=2 & reg_s=7 & reg_s ;imm16{tmp:2 = imm16; reg_s=reg_s+2; export tmp;}
OPS: "#"imm16" OK2d"		is byte=1 & met_s=2 & reg_s=7 & reg_s ;imm16{reg_s=reg_s+2; export *:2 reg_s;}

OPS: "#"imm32L"OK2e"	is byte=0 & met_s=2 & reg_s=7 & met_d=2 & reg_d=7;imm32L {tmp:2 = imm32L; export tmp;}

# MODE3: (autoincrement deferred)
# EA_ptr = Rn
# EA = MEM[EA_ptr]
# operand = MEM[EA]
# Rn = Rn + 2

OPS: "@("reg_s")+ OK3a"		is met_s=3& reg_ss!=7 & (met_d=0 | met_d=1 | met_d=4 | met_d=5)   & reg_s 				{tmp:2 = *:2 reg_s; tmp2=*:2 tmp; reg_s=reg_s+2; export tmp2;}
OPS: "@("reg_s")+ OK3b"		is met_s=3& reg_ss!=7 & (met_d=2 | met_d=3) &                 reg_d!=7        & reg_s	{tmp:2 = *:2 reg_s; tmp2=*:2 tmp; reg_s=reg_s+2; export tmp2;}
OPS: "@("reg_s")+ OK3c"		is met_s=3& reg_ss!=7 & (met_d=2 | met_d=3) &                 reg_d=7         & reg_s	{tmp:2 = *:2 reg_s; tmp2=*:2 tmp; reg_s=reg_s+2; export tmp2;}
OPS: "@("reg_s")+ OK3d"		is met_s=3& reg_ss!=7 & (met_d=6 | met_d=7) &                        reg_s 				{tmp:2 = *:2 reg_s; tmp2=*:2 tmp; reg_s=reg_s+2; export tmp2;}
OPS: "@#"imm16" OK3e"		is met_s=3&  reg_ss=7 & (met_d=0 | met_d=1 | met_d=4 | met_d=5)    & reg_s ;imm16 		{tmp:2 =imm16; export tmp;}
OPS: "@("reg_s")+ OK3f"		is met_s=3&  reg_ss=7 & (met_d=2 | met_d=3) &                 reg_d!=7         & reg_s 	{tmp:2 = *:2 reg_s; tmp2=*:2 tmp; reg_s=reg_s+2; export tmp2;}
OPS: "@#"imm32L" OK3g"		is met_s=3&  reg_ss=7 & (met_d=2 | met_d=3) &                 reg_d=7  & reg_s;imm32L	{tmp:2 = imm32L; export tmp;}
OPS: "@#"imm32L" OK3h"		is met_s=3&  reg_ss=7 & (met_d=6 | met_d=7) &                  reg_s ;imm32L			{tmp:2 = imm32L; export tmp;}

# MODE4: (autodecrement)
# Rn = Rn - (is_byte ? 1 : 2)
# EA = Rn
# operand = MEM[EA]
OPS: "-("reg_s") OK4a"		is byte=1 & met_s=4 & reg_s {reg_s=reg_s-1; export *:2 reg_s;}
OPS: "-("reg_s") OK4b"		is byte=0 & met_s=4 & reg_s {reg_s=reg_s-2; export *:2 reg_s;}

# MODE5: (autodecrement deferred)
# Rn = Rn - 2
# EA_ptr = Rn
# EA = MEM[EA_ptr]
# operand = MEM[EA]
OPS: "@-("reg_s") OK5a"		is met_s=5 & reg_s {reg_s=reg_s-2; tmp:2 = *:2 reg_s; export *:2 tmp;}

# MODE6: (index)
# EA = Rn + offset
# operand = MEM[EA]
OPS: imm16"("reg_s") OK6a"	is met_s=6 & reg_s		;imm16			{tmp:2 = imm16+reg_s; export *:2 tmp;}
OPS: REL16"] OK6b"			is met_s=6 & reg_s=7 	;REL16			{tmp:2= REL16; export tmp;} #ar tikrai
OPS: REL32L" OK6c"			is met_s=6 & met_d=6 & reg_s=7 ;REL32L	{tmp:2 = REL32L; export *:2 tmp;}
OPS: REL32L" OK6d"			is met_s=6 & met_d=7 & reg_s=7 ;REL32L	{tmp:2 = REL32L; export *:2 tmp;}
OPS: imm32L"("reg_s") OK6e"	is met_s=6 & met_d=6 & reg_s ;imm32L	{tmp:2 = imm32L+reg_s; export *:2 tmp;}
OPS: imm32L"("reg_s")?OK6f"	is met_s=6 & met_d=7 & reg_s ;imm32L	{tmp:2 = imm32L+reg_s; export *:2 tmp;}
OPS: REL32L" OK6g"			is met_s=6 & met_d=3 & reg_s=7;REL32L	{tmp:2 = REL32L; export *:2 tmp;}
OPS: imm32L" OK6h"			is met_s=6 & met_d=3 & reg_d=7 & reg_s!=7;imm32L	{tmp:2 = imm32L; export *:2 tmp;}

# MODE7: (index deferred)
# EA_ptr = Rn + offset
# EA = MEM[EA_ptr]
# operand = MEM[EA]
OPS: "@"imm16"("reg_s")7a" is met_s=7 & (met_d=0 | met_d=1 | met_d=4 | met_d=5) & reg_ss!=7 & reg_s ;imm16	{tmp:2 = imm16+reg_s; export *:2 tmp;}
OPS: "@"REL16" 7f" 			is met_s=7 & (met_d=0 | met_d=1 | met_d=4 | met_d=5) & reg_ss=7 & reg_s ;REL16	{tmp:2 = REL16; export *:2 tmp;}
OPS: "@"REL16"("reg_s")7b"	is met_s=7 & (met_d=2 | met_d=3) &reg_d!=7 & reg_s 			;REL16				{tmp:2 = REL16+reg_s; export *:2 tmp;}
OPS: "@"REL32L"?OK7c"		is met_s=7 & reg_s=7 & (met_d=2 | met_d=3) &reg_d=7				;REL32L			{tmp:2 = REL32L; export *:2 tmp;}
OPS: "@"imm32L"("reg_s") OK7cc"	is met_s=7 & reg_ss!=7 & (met_d=2 | met_d=3) &reg_d=7 &reg_s;imm32L			{tmp:2 = imm32L+reg_s; export *:2 tmp;}
OPS: "@"imm32L"?OK7d"		is met_s=7 &         (met_d=6 | met_d=7) & reg_ss!=7	&reg_s	;imm32L			{tmp:2 = imm32L+reg_s; export *:2 tmp;}
OPS: "@"REL32L"?OK7e"		is met_s=7 &         (met_d=6 | met_d=7) & reg_s=7				;REL32L			{tmp:2 = REL32L; export *:2 tmp;}

# DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION DESTINATION
OPD: reg_d" OK0"	is met_d=0 & reg_d 			{export reg_d;}
OPD: "("reg_d") OK1"	is met_d=1 & reg_d 		{tmp:2=reg_d; export *:2 tmp;}

# MODE2: (autoincrement)
# EA = Rn
# operand = MEM[EA]
# Rn = Rn + (is_byte ? 1 : 2)

OPD: "("reg_d")+ OK2a"		is byte=1 & met_d=2 & reg_d {tmp:2=reg_d; reg_d=reg_d+1; export *:2 tmp; }
OPD: "("reg_d")+ OK2b"		is byte=0 & met_d=2 & reg_d {tmp:2=reg_d; reg_d=reg_d+2; export *:2 tmp; }
OPD: "#"imm16" OK2c"		is byte=0 & met_d=2 & reg_d=7 & reg_d ;imm16{tmp:2 = imm16; reg_d=reg_d+2; export tmp;}
OPD: "#"imm16" OK2d"		is byte=1 & met_d=2 & reg_d=7 & reg_d ;imm16{tmp:2 = imm16; reg_d=reg_d+2; export tmp;}

OPD: "#"imm32H"OK2e"	is byte=0 & met_s=2 & reg_s=7 & met_d=2 & reg_d=7;imm32H {tmp:2 = imm32H; export tmp;}


# MODE3: (autoincrement deferred)
# EA_ptr = Rn
# EA = MEM[EA_ptr]
# operand = MEM[EA]
# Rn = Rn + 2
OPD: "@("reg_d")+ OK3a"		is met_d=3& reg_dd!=7 & (met_s=0 | met_s=1 | met_s=4 | met_s=5) & reg_d 		{tmp:2=*:2 reg_d; reg_d=reg_d+2; export *:2 tmp;}
OPD: "@("reg_d")+ OK3b"		is met_d=3& reg_dd!=7 & (met_s=2 | met_s=3) &    reg_s!=7 & reg_d 				{tmp:2=*:2 reg_d; reg_d=reg_d+2; export *:2 tmp;}
OPD: "@("reg_d")+ OK3c"		is met_d=3& reg_dd!=7 & (met_s=2 | met_s=3) &  reg_s=7 & reg_d 					{tmp:2=*:2 reg_d; reg_d=reg_d+2; export *:2 tmp;}
OPD: "@("reg_d")+ OK3d"		is met_d=3& reg_dd!=7 & (met_s=6 | met_s=7) &  reg_d 							{tmp:2=*:2 reg_d; reg_d=reg_d+2; export *:2 tmp;}
OPD: "@#"imm16" OK3e"		is met_d=3&  reg_dd=7 & (met_s=0 | met_s=1 | met_s=4 | met_s=5) & reg_d ;imm16 	{tmp:2 =imm16; export *:2 tmp;}
OPD: "@("reg_d")+ OK3f"		is met_d=3&  reg_dd=7 & (met_s=2 | met_s=3) &   reg_s!=7 & reg_d 				{tmp:2=*:2 reg_d; reg_d=reg_d+2; export *:2 tmp;}
OPD: "@#"imm32H" OK3g"		is met_d=3&  reg_dd=7 & (met_s=2 | met_s=3) &   reg_s=7  & reg_d;imm32H 		{tmp:2 = imm32H; export *:2 tmp;}
OPD: "@#"imm32H" OK3h"		is met_d=3&  reg_dd=7 & (met_s=6 | met_s=7) & reg_d=7  ; imm32H 				{tmp:2 = imm32H; export *:2 tmp;}

# MODE4: (autodecrement)
# Rn = Rn - (is_byte ? 1 : 2)
# EA = Rn
# operand = MEM[EA]
OPD: "-("reg_d") OK4a"	is byte=1 & met_d=4 & reg_d 	{reg_d=reg_d-1; tmp:2=reg_d; export *:2 tmp;}
OPD: "-("reg_d") OK4b"	is byte=0 & met_d=4 & reg_d 	{reg_d=reg_d-2; tmp:2=reg_d; export *:2 tmp;}

# MODE5: (autodecrement deferred)
# Rn = Rn - 2
# EA_ptr = Rn
# EA = MEM[EA_ptr]
# operand = MEM[EA]
OPD: "@-("reg_d") OK5a"	is met_d=5 & reg_d 	{reg_d=reg_d-2; tmp:2 = *:2 reg_d; export *:2 tmp;}

# MODE6: (index)
# EA = Rn + offset
# operand = MEM[EA]
OPD: imm16"("reg_d") OK6a"	is met_d=6 & reg_d;imm16							{tmp:2 = imm16+reg_d;	export *:2 tmp;}
OPD: REL16" OK6b"			is met_d=6 & reg_d=7 ;REL16							{tmp:2 = REL16;			export *:2 tmp;}
OPD: REL32H" OK6c"			is met_d=6 & met_s=6 & reg_d=7 ;REL32H				{tmp:2 = REL32H;		export *:2 tmp;}
OPD: REL32H" OK6d"			is met_d=6 & met_s=7 & reg_d=7 ;REL32H				{tmp:2 = REL32H;		export *:2 tmp;}
OPD: imm32H"("reg_d") OK6e"	is met_d=6 & met_s=6 & reg_d ;imm32H				{tmp:2 = imm32H+reg_d;	export *:2 tmp;}
OPD: imm32H"("reg_d")?OK6f"	is met_d=6 & met_s=7 & reg_d ;imm32H				{tmp:2 = imm32H+reg_d;	export *:2 tmp;}
OPD: REL32H" OK6g"			is met_d=6 & met_s=3 & reg_d=7;REL32H				{tmp:2 = REL32H;		export *:2 tmp;}
OPD: imm32H" OK6h"			is met_d=6 & met_s=3 & reg_s=7 & reg_d!=7;imm32H	{tmp:2 = imm32H;		export *:2 tmp;}

# MODE7: (index deferred)
# EA_ptr = Rn + offset
# EA = MEM[EA_ptr]
# operand = MEM[EA]
OPD: "@"imm16"("reg_d")7a" is met_d=7 & (met_s=0 | met_s=1 | met_s=4 | met_s=5) & reg_dd!=7 & reg_d ;imm16	{tmp:2 = imm16+reg_d; tmp2=*:2 tmp; export *:2 tmp2;}
OPD: "@"REL16" ok7f" is met_d=7 & (met_s=0 | met_s=1 | met_s=4 | met_s=5) & reg_dd=7 & reg_d ;REL16			{tmp:2 = REL16; export *:2 tmp;}
OPD: "@"REL16"("reg_d")7b" is met_d=7 & (met_s=2 | met_s=3) &reg_s!=7 & reg_d 			;REL16				{tmp:2 = REL16; export *:2 tmp;}
OPD: "@"REL32H"?OK7c"	is met_d=7 & reg_d & (met_s=2 | met_s=3) &reg_s=7				;REL32H				{tmp:2 = REL32H; export *:2 tmp;}
OPD: "@"imm32H"("reg_d") OK7cc"	is met_d=7 & reg_dd!=7 & (met_s=2 | met_s=3) &reg_s=7 & reg_d	;imm32H		{tmp:2 = imm32H+reg_d; tmp2=*:2 tmp; export *:2 tmp2;}
OPD: "@"imm32H"?OK7d"	is met_d=7 &         (met_s=6 | met_s=7) & reg_d!=7				;imm32H				{tmp:2 = imm32H; export *:2 tmp;}
OPD: "@"REL32H"?OK7e"	is met_d=7 &         (met_s=6 | met_s=7) & reg_d=7				;REL32H				{tmp:2 = REL32H; export *:2 tmp;}

######### XOR SOB MUL DIV ASH ASHC
:XOR reg_s,OPD	is (kodas_s=7 &met_s=4 & reg_s) ...& OPD {OPD=OPD^reg_s; FLZ(OPD);FLN(OPD);CV();}
:SOB reg_s,RELN	is kodas_s=7 &met_s=7 & reg_s & RELN &nnn {reg_s=reg_s-1;if (reg_s==0) goto inst_next;goto [RELN];} # SOB RRR,NNN NNN : R := R – 1; IF (R != 0) THEN PC := PC – 2 * NN


:MUL reg_s,OPD	is (kodas_s=7 &met_s=0 & reg_s) ...& OPD {
r:4=zext(OPD)*zext(reg_s); 
OPD=r[0,15];
reg_s=r[16,15];
Z(r==0);CV();
N((r>>31)==1);
#C((r)>32767 or r<-32768);#???? kaip?
}
:DIV reg_s,OPD	is (kodas_s=7 &met_s=1 & reg_s) ...& OPD {
#bibiene?
OPD=OPD/reg_s;  FLZ(OPD); FLN(OPD);}
:ASH reg_s,OPD	is (kodas_s=7 &met_s=2 & reg_s) ...& OPD {
if((reg_s&0x8000)==0x8000)goto<a>;
OPD=OPD<<(reg_s&0x3F);
goto<b>;
<a>
OPD=OPD>>(reg_s&0x3F);
<b>
FLZ(OPD); FLN(OPD);}
:ASHC reg_s,OPD	is (kodas_s=7 &met_s=3 & reg_s) ...& OPD {
if((reg_s&0x8000)==0x8000)goto<a>;
OPD=OPD<<(reg_s&0x3F);
goto<b>;
<a>
OPD=OPD>>(reg_s&0x3F);
<b>
FLZ(OPD); FLN(OPD);}

##################################################################################

:MOV OPS,OPD 	is (kodas_s=0x1)...& OPD & OPS {tmp:1=0;signn(OPS, tmp);N(tmp);FLZ(OPS); OPD = OPS; CV();}
:MOVB OPS,OPD 	is (kodas_s=0x9)...& OPD & OPS {OPD=OPD & 0xFF00; OPD =OPD | (OPS & 0x00FF); FLZ(OPS & 0x00FF);}
:CMP OPS,OPD 	is (kodas_s=0x2)... & OPD & OPS {CMP_FLAGS(OPD,OPS);}
:CMPB OPS,OPD 	is (kodas_s=0xA)... & OPD & OPS {CMP_FLAGS(OPD<<8,OPS<<8); FLZ((OPD&0xFF)==(OPS&0xFF));}
:SUB OPS,OPD 	is (kodas_s=0xE)... & OPS & OPD {SUB_FLAGS(OPS,OPD); OPD=OPD-OPS;FLN(OPD);}
:ADD OPS,OPD 	is (kodas_s=0x6)... & OPS & OPD {ADD_FLAGS(OPS,OPD);OPD=OPD+OPS;FLN(OPD);}

:BIT OPS,OPD 	is (kodas_s=0x3)... & OPS & OPD {tmp:2=OPS&OPD;FLN(tmp);FLZ(tmp);CV();}
:BITB OPS,OPD 	is (kodas_s=0xB)... & OPS & OPD {tmp:2=OPS&OPD;FLN(tmp<<8);FLZ(tmp&0xFF);CV();}
:BIC OPS,OPD 	is (kodas_s=0x4)... & OPS & OPD {OPD=(~OPS) & OPD;FLZ(OPD);FLN(OPD); CV();} #bit clear dst=not(src) and (dst)
:BICB OPS,OPD 	is (kodas_s=0xC)... & OPS & OPD {tmp=OPD&0xFF00;OPD=((~OPS)&0x00FF)|tmp;FLZ(OPD&0x00FF);FLN(OPD<<8); CV();}
:BIS OPS,OPD 	is (kodas_s=0x5)... & OPS & OPD {OPD=OPD | OPS; FLN(OPD);FLZ(OPD);CV();}
:BISB OPS,OPD 	is (kodas_s=0xD)... & OPS & OPD {OPD=OPD | (OPS&0xFF); FLN(OPD);FLZ(OPD);CV();}
:INC OPD		is (kodas_s=0 & met_s=5 &reg_s=2)... &OPD {V(OPD==0x7FFF);OPD=OPD+1; FLZ(OPD);FLN(OPD);}
:INCB OPD		is (kodas_s=8 & met_s=5 &reg_s=2)... &OPD {V(OPD==0x7F);tmp=OPD & 0xFF00; OPD=((OPD+1)&0x00FF)|tmp; FLZ(OPD & 0xFF00); FLN(OPD<<8);}
:CLR OPD		is (kodas_s=0 & met_s=5 &reg_s=0)... &OPD {OPD=0; CN(); SZ(); CV(); CC();}
:CLRB OPD		is (kodas_s=8 & met_s=5 &reg_s=0)... &OPD {OPD=OPD & 0xFF00; CN(); SZ(); CV(); CC();}

:COM OPD		is (kodas_s=0 & met_s=5 &reg_s=1)... &OPD {OPD=~OPD; FLZ(OPD);FLN(OPD); CV(); SC();}
:COMB OPD		is (kodas_s=8 & met_s=5 &reg_s=1)... &OPD {tmp=OPD&0xFF00;OPD=((~OPD)&0x00FF)|tmp;FLZ(OPD&0x00FF);FLN(OPD<<8); CV(); SC();}
:DEC OPD		is (kodas_s=0 & met_s=5 &reg_s=3)... &OPD {V(OPD==0x8000);OPD=OPD-1;FLZ(OPD);FLN(OPD);}
:DECB OPD		is (kodas_s=8 & met_s=5 &reg_s=3)... &OPD {tmp0:2=OPD&0xFF00;OPD=OPD&0xFF;V(OPD==0x80);OPD=(OPD-1)&0xFF;FLZ(OPD);FLN(OPD<<8);OPD=OPD|tmp0;}

:NEG OPD		is (kodas_s=0 & met_s=5 &reg_s=4)... &OPD {OPD=-OPD; FLZ(OPD); FLV(OPD);FLN(OPD);C(OPD!=0);}

:NEGB OPD		is (kodas_s=8 & met_s=5 &reg_s=4)... &OPD {tmp0=OPD&0xFF00;OPD=(0-OPD)&0xFF;V(OPD==0x80);FLZ(OPD);FLN(OPD<<8);C(OPD!=0);OPD=OPD|tmp0;}
:ADC OPD		is (kodas_s=0 & met_s=5 &reg_s=5)... &OPD {tmp:2=OPD+(PS&1);SV();if((OPD==0x7FFF)&((PS&1)==1))goto<a>;CV();<a>SC();if((OPD==0xFFFF)&((PS&1)==1))goto<b>;CC();<b>OPD=tmp;FLZ(OPD);FLN(OPD);}
:ADCB OPD		is (kodas_s=8 & met_s=5 &reg_s=5)... &OPD {tmp0:2=OPD&0xFF00;tmp:2=(OPD&0xFF)+(PS&1);SV();OPD=OPD&0xFF;if((OPD==0x7F)&((PS&1)==1))goto<a>;CV();<a>SC();if((OPD==0xFF)&((PS&1)==1))goto<b>;CC();<b>OPD=tmp;FLZ(OPD);FLN(OPD<<8);OPD=OPD|tmp0;}

:SBC OPD		is (kodas_s=0 & met_s=5 &reg_s=6)... &OPD {tmp=OPD-(PS&1);V(OPD+(PS&1)==0x8001);C(OPD-(PS&1)==0xFFFF);OPD=tmp;FLN(OPD);FLZ(OPD);}
:SBCB OPD		is (kodas_s=8 & met_s=5 &reg_s=6)... &OPD {tmp0=OPD&0xFF00;OPD=OPD&0xFF;tmp=OPD-(PS&1);V(OPD+(PS&1)==0x81);C(OPD-(PS&1)==0xFF);OPD=tmp;FLN(OPD<<8);FLZ(OPD);OPD=OPD|tmp0;}

:ROR OPD		is (kodas_s=0 & met_s=6 &reg_s=0)... &OPD {tmp:2=OPD & 1;tmp2:2=0;OPD=OPD>>1;if !(PS[0,1]) goto <c>;tmp2=0x8000;<c>CC();OPD=OPD | tmp2;PS=PS|tmp;FLZ(OPD); FLN(OPD);V_NZ();}
:RORB OPD		is (kodas_s=8 & met_s=6 &reg_s=0)... &OPD {tmp:2=(OPD&0xFF00)|((PS&1)<<7);CC();PS=PS|(OPD&1);OPD=((OPD&0x00FF)>>1)|tmp;FLZ(OPD&0x00FF);FLN(OPD<<8);V_NZ();}
:ROL OPD		is (kodas_s=0 & met_s=6 &reg_s=1)... &OPD {tmp:2=OPD>>15;OPD=(OPD<<1)|(PS & 1);CC();PS=PS|tmp;FLZ(OPD);FLN(OPD);V_NZ();}
:ROLB OPD		is (kodas_s=8 & met_s=6 &reg_s=1)... &OPD {tmp0:2=OPD&0xFF00;OPD=OPD&0xFF;tmp:2=OPD>>7;OPD=(OPD<<1)|(PS & 1);CC();PS=PS|tmp;FLZ(OPD);FLN(OPD<<8);V_NZ();OPD=OPD|tmp0;}
:ASR OPD		is (kodas_s=0 & met_s=6 &reg_s=2)... &OPD {tmp:2=OPD & 0x8000;PS[0,1]=(OPD & 1)==1;OPD=(OPD>>1) | tmp;FLZ(OPD);FLN(OPD);V_NZ();}
:ASRB OPD		is (kodas_s=8 & met_s=6 &reg_s=2)... &OPD {tmp=OPD&0xFF80;CC();PS=PS|(OPD&1);OPD=(OPD>>1)|tmp;FLZ(OPD&0x00FF);FLN(OPD<<8);V_NZ();}
:ASL OPD		is (kodas_s=0 & met_s=6 &reg_s=3)... &OPD {PS[0,1]=(OPD & 0x8000)!=0;OPD=OPD<<1;FLZ(OPD); FLN(OPD); V_NZ();}

:ASLB OPD		is (kodas_s=8 & met_s=6 &reg_s=3)... &OPD {PS[0,1]=(OPD & 0x0080)!=0;tmp=OPD&0xFF00;OPD=(OPD&0x007F)<<1;FLZ(OPD);FLN(OPD<<8); V_NZ();OPD=OPD|tmp;}
:TST OPD		is (kodas_s=0 & met_s=5 &reg_s=7)... &OPD {FLZ(OPD); CV(); CC(); FLN(OPD);}
:TSTB OPD		is (kodas_s=8 & met_s=5 &reg_s=7)... &OPD {FLZ(OPD & 0x00FF); CV(); CC(); FLN(OPD<<8);}
:SXT OPD		is (kodas_s=0 & met_s=6 &reg_s=7)... &OPD {tmp=0xFFFF;if (PS[3,1]) goto <b>;tmp=0;<b>OPD=tmp;}
:SWAB OPD		is (kodas_s=0 & met_s=0 &reg_s=3)... &OPD {tmp=OPD>>8; OPD=(OPD<<8)|tmp;FLN(OPD<<8);FLZ(OPD&0xFF);CV();CC();}
:MFPS OPD		is (kodas_s=8 & met_s=6 &reg_s=7)... &OPD {tmp=OPD&0xFF00;OPD=PS&0xFF|tmp;FLZ(OPD&0xFF);CV();N((OPD&0x80)==0x80);}
:MTPS OPD		is (kodas_s=8 & met_s=6 &reg_s=4)... &OPD {tmp=OPD&0b01010101;PS=PS&(~0b01010101)|tmp;}
############################################################################################

# Jumpai (PC registras, R7)
#          543210
# 2 - #X   010 111 = 17
# 3 - @#X  011 111 = 1f
# 6 - X    110 111 = 37
# 7 - @X   111 111 = 3f

# JMP - jumps. Some of these make no sense, but are legal. Or semi-legal.
:JMP ""reg_d" ok0" 		is kodas_s=0 & met_s=0 & reg_s=1 & met_d=0 & reg_d {PC=reg_d; goto reg_d;} #OK
:JMP "("reg_d") ok1" 	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=1 & reg_d {PC=reg_d; goto [PC];} #OK
:JMP "#"imm16" ok2a"	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=2 & reg_d=7; imm16 {PC=imm16; goto [PC];}
:JMP "("reg_d")+ ok2b"	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=2 & reg_dd!=7 & reg_d { PC=reg_d; reg_d=reg_d+2; goto [PC];}
:JMP "@#"imm16" ok3"	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=3 & reg_d=7; imm16 {PC=imm16; goto [PC];}
:JMP "-("reg_d") ok4" 	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=4 & reg_d {reg_d=reg_d-2; PC=reg_d; goto [PC];} #OK
# met_d=5
:JMP REL16 "ok6"		is kodas_s=0 & met_s=0 & reg_s=1 & met_d=6 & reg_d=7 ; REL16{PC=REL16; goto [PC];}
:JMP "@"REL16" ok7" 	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=7 & reg_d=7; REL16 {goto [REL16];}

# JSR methods.
I16: imm16	is imm16 {export *:2 imm16;}

:JSRa reg_s,(reg_d)	is  kodas_s=0 & met_s=4 & reg_ss<7 &reg_dd!=7& met_d=1 & reg_s &reg_d {tmp:2=reg_d;push(reg_s);reg_s=PC+2;PC=tmp;call[PC];}
:JSRb reg_s,#I16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=1)& reg_s ;I16 {push(PC+2); tmp=reg_s+I16; call [tmp];}
:JSRc reg_s,#I16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=2)& reg_s ;I16 {push(PC+2); tmp=reg_s+I16; call [tmp];}
:JSRd reg_s,@#I16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=3)& reg_s ;I16 {push(PC+2); tmp=I16+reg_s; call [*:2 tmp];}
:JSRe reg_s,REL16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=6)& reg_s ;REL16 {push(PC+2); tmp=reg_s+REL16; call [*:2 tmp];}
:JSRf reg_s,@REL16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=7)& reg_s ;REL16 {push(PC+2); tmp=reg_s+REL16; call [*:2 tmp];}
:JSRg "PC?",OPD	is (kodas=0x27 & reg_d!=7)... & OPD {call OPD;}

:"ILLEGAL CALL 0>"REL16	is (kodas=0x27 & met_d=0 & reg_d=7) ; REL16 {push(PC+2); call [REL16]; }
:"ILLEGAL CALL 1>"REL16	is (kodas=0x27 & met_d=1 & reg_d=7) ; REL16 {push(PC+2); call [REL16]; }
:CALL #I16				is (kodas=0x27 & met_d=2 & reg_d=7) ; I16 {push(PC+2);call [I16];}
:CALL @#I16				is (kodas=0x27 & met_d=3 & reg_d=7) ; I16 {push(PC+2);call I16; }
:"ILLEGAL CALL 4>"REL16	is (kodas=0x27 & met_d=4 & reg_d=7) ; REL16 {push(PC+2);call [REL16]; }
:"ILLEGAL CALL 5>"REL16	is (kodas=0x27 & met_d=5 & reg_d=7) ; REL16 {push(PC+2);call [REL16]; }
:CALL REL16				is (kodas=0x27 & met_d=6 & reg_d=7) ; REL16 {push(PC+2); call [REL16]; }
:CALL "@"REL16			is (kodas=0x27 & met_d=7 & reg_d=7) ; REL16 {push(PC+2); call [REL16]; }

###### RETURN
:RETURN		is imm16=0x87 {pop(PC);return [PC];}
:RTS reg_d	is kodas=2 & metod=0 & regai<7 &reg_d {PC=reg_d;pop(reg_d);return [PC];}

:MARK nnn is kodas=0x34 &nnn {SP=PC+2*nnn;PC=R5;pop(R5);} # SP := PC + 2 * NN; PC := R5; R5 := (SP)+

######## FPU FPU FPU #########################
FRD: reg_d is reg_d			{ export *:1 reg_d; }
:FADD FRD	is fpu=0b0111101000000 & FRD {PC=PC;}
:FSUB FRD	is fpu=0b0111101000001 & FRD {PC=PC;}
:FMUL FRD	is fpu=0b0111101000010 & FRD {PC=PC;}
:FDIV FRD	is fpu=0b0111101000011 & FRD {PC=PC;}

######## HALT MODE ############################

#:START ($RUN$) = o10-o13
#:STEP ($STEP$) =o14-o17
#:RSEL ($MFSL$) =o20
#:MFUS ($MFPM$) = o21
#:RCPC ($MFPC$) = o22-o23
#:RCPS ($MFPS$) = o24-o27
#:MTUS ($MTPM$) = o31
#:WCPC ($MTPC$) = o32-o33
#:WCPS ($MTPS$) = o34-o37
#:???? = o30

