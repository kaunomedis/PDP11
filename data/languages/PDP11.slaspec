# WARNING! ALL STUFF in {} is untested.

define endian=little;
define alignment=2;

define space ram      type=ram_space      size=2 default; # would like to have 3, but errors...
define space register type=register_space size=2;

# R0–R7 (SP=R6, PC=R7)
define register offset=0x0000 size=2 [ R0 ];
define register offset=0x0002 size=2 [ R1 ];
define register offset=0x0004 size=2 [ R2 ];
define register offset=0x0006 size=2 [ R3 ];
define register offset=0x0008 size=2 [ R4 ];
define register offset=0x000A size=2 [ R5 ];
define register offset=0x000C size=2 [ SP ]; #R6 , stekas mazejantis

define register offset=0x000E size=2 [ PC ]; #R7
define register offset=0x0020 size=2 [ PS ]; # ony one byte. Keep 2 to make SLEIGHT happy

# Flag Register Contents (PS)
#
# b15         - Reserved area
# b14:b12     - Processor interrupt priority level
# b11:b8     - Reserved area
# b7        - (U) Stack pointer select flag
# b6         - (I) Interrupt enable flag
# b5         - (O)(V) Overflow flag
# b4        - (B) Register bank select flag
# b3         - (S)(N) Sign flag
# b2        - (Z) Zero flag
# b1        - (D) Debug flag
# b0        - (C) Carry flag


macro C(a){PS[0,1]=a;}
macro CC(){PS[0,1]=0;}
macro SC(){PS[0,1]=1;}
macro Z(a){PS[2,1]=a;}
macro CZ(){PS[2,1]=0;}
macro SZ(){PS[2,1]=1;}
macro S(a){PS[3,1]=a;}
macro N(a){PS[3,1]=a;}
macro CS(){PS[3,1]=0;}
macro SS(){PS[3,1]=1;}
macro CN(){PS[3,1]=0;}
macro SN(){PS[3,1]=1;}
macro V(a){PS[5,1]=a;}
macro CV(){PS[5,1]=0;}
macro SV(){PS[5,1]=1;}
macro I(a){PS[6,1]=a;}
macro CHKNZ(a){PS[3,1]=(a & 0x8000)!=0;PS[2,1]=(a==0);}
macro V_NZ(){PS[5,1]=PS[0,1] ^ PS[3,1];}
macro signn(check, result){result=(check & 0x8000)!=0;}

macro ADD_FLAGS(ss,dd) {
ts=(ss & 0x8000)!=0;
td=(dd & 0x8000)!=0;
tr=(((ss+dd) & 0x8000)!=0);
Z(ss==dd);
V((!(ts ^ td)) & (tr ^ td));
C((ts & td)|(ts ^ td) & !tr);
}
macro SUB_FLAGS(ss,dd){
ts=(ss & 0x8000)!=0;
td=(dd & 0x8000)!=0;
tr=(((ss-dd) & 0x8000)!=0);
Z(ss==dd);
V((ts ^ td) & (!(tr ^ td)));
C((ts & !(td))|(!(ts ^ td) & tr));
N(dd>ss);
}

macro CMP_FLAGS(ss,dd) {

ts=(ss & 0x8000)!=0;
td=(dd & 0x8000)!=0;
tr=(((ss-dd) & 0x8000)!=0);
Z(ss==dd);
V((ts ^ td) & (!(tr ^ td)));
C(((!ts) & td)|(!(ts ^ td) & tr));
N(dd>ss);

}

macro FLZ(register){PS[2,1]=(register==0);}
macro FLV(register){V((register & 0xFFFF)==0xFFFF);}
macro FLN(register){PS[3,1]=(register & 0x8000)!=0;}
#macro MemRead(dest,adresas) {
#   	ptr:2 = adresas;
#	dest = *:2 ptr;
#}

#macro MemStore(adresas,val) {ptr:2 = adresas;*:2 ptr = val;}

macro push(val) {
    SP = SP - 2;
    *:2 SP = val;
}
macro pop(val) {
    val = *:2 SP;
    SP = SP + 2;
}

#TOKENS

# main opcode
define token word_1 (16)
	byte = (15,15)
	kodas = (6,15)
	metod = (3,5)
	regai =(0,2)
	
	op_h =(8,15)
	rell = (0,7) signed
	baitas = (0,7)
	
	kodas_s = (12,15)
	met_s=(9,11)
	reg_s=(6,8)
	reg_ss=(6,8)
	met_d=(3,5)
	reg_d=(0,2)
	reg_dd=(0,2)
	nnn=(0,5)
	fpu=(3,15)
;

attach variables [ reg_s] [ R0 R1 R2 R3 R4 R5 SP PC];
attach variables [ reg_d] [ R0 R1 R2 R3 R4 R5 SP PC];

# next word with data or first opcode
define token data_word (16)
	imm16 = (0,15)
	rell16	=(0,15) signed
;

# THIS HACK. I do not know how to use two imm16, two words of data (4 bytes)
define token data_double_word (32)
	imm32=(0,31)
	imm32H=(16,31)
	rell32h=(16,31) signed
	imm32L=(0,15)
	rell32l=(0,15) signed
;
# Relative addressing. Note x2 multiplication (adressing is in words)
REL8:	reloc	is rell			[reloc = inst_next + 2 * rell;]	{ tmp:2 = 0; tmp=reloc; export  tmp;} 
# relative values from extra bytes.
REL32H:	reloc 	is rell32h  	[reloc = inst_next + rell32h;]	{ tmp:2 = 0; tmp=reloc; export  tmp; } 
REL32L:	reloc 	is rell32l  	[reloc = inst_next + rell32l-2;]	{tmp:2 = 0; tmp=reloc; export  tmp; } 
REL16:	reloc	is rell16   	[reloc = inst_next + rell16;]	{tmp:2 = 0; tmp=reloc; export  tmp; }
RELN:	reloc	is nnn	[reloc = inst_next-nnn*2;]		{tmp:2 = 0; tmp=reloc; export  tmp; } 

# ############# VEIKIANTYS 
:NOP		is imm16=0x0A0	{R0=R0;}
:HALT		is imm16=0		{ tmp:2=0x28; PC=*:2 tmp; tmp=0x2A; PS=*:2 tmp; goto [PC];}
:WAIT		is imm16=1		{ PC=PC; goto [PC];}
:CLC		is imm16=0x0A1 {CC();}
:CLV		is imm16=0x0A2 {CV();}
:CLZ		is imm16=0x0A4 {CZ();}
:CLN		is imm16=0x0A8 {CN();}
:CCC		is imm16=0x0AF {CC();CV();CZ();CN();}

:SEC		is imm16=0x0b1 {SC();}
:SEV		is imm16=0x0b2 {SV();}
:SEZ		is imm16=0x0b4 {SZ();}
:SEN		is imm16=0x0b8 {SN();}
:SCC		is imm16=0x0bF {SC();SV();SZ();SN();}
:EMT "'"baitas"'"		is op_h=0x88 & baitas { push(PS); push(PC); PC=(0x18);PS=(0x1A); call [PC];} # NETEISYBE
:TRAP		is op_h=0x89 {push(PS); push(PC); tmp:2=0x1c; PC=*:2 tmp; tmp=0x1e; PS=*:2 tmp; goto [PC]; call [PC];} # NETEISYBE
:IOT		is imm16=0x004 {push(PS); push(PC); PC=(0x10); PS=(0x12); call [PC];} # NETEISYBE
:BPT		is imm16=0x003 {push(PS); push(PC); PC=(0x0C); PS=(0x0E); call [PC];} # NETEISYBE
:RTI		is imm16=0x002 {pop(PC); pop(PS); return [PC];} # NETEISYBE
:RTT		is imm16=0x006 {pop(PC); pop(PS); return [PC];} # NETEISYBE
:RESET		is imm16=0x005 {SP=SP;}

:BR   REL8			is op_h=1 & REL8 {goto [REL8];}
:BNE  REL8			is op_h=2 & REL8 {if PS[2,1] goto inst_next; goto [REL8];} # Z=0
:BEQ  REL8			is op_h=3 & REL8 {if !PS[2,1] goto inst_next; goto [REL8];} # Z=1
:BPL  REL8			is op_h=0x80 & REL8 {if PS[3,1] goto inst_next; goto [REL8];} # N=0 sign
:BMI  REL8			is op_h=0x81 & REL8 {if !PS[3,1] goto inst_next; goto [REL8];} # N=1
:BVC  REL8			is op_h=0x84 & REL8 {if PS[5,1] goto inst_next; goto [REL8];} # V=0 overflow
:BVS  REL8			is op_h=0x85 & REL8 {if !PS[5,1] goto inst_next; goto [REL8];} # V=1
:BCC  REL8			is op_h=0x86 & REL8 {if PS[0,1] goto inst_next; goto [REL8];} # C=0 carry
:BCS  REL8			is op_h=0x87 & REL8 {if !PS[0,1] goto inst_next; goto [REL8];} # C=1
:BGE  REL8			is op_h=4 & REL8 {if (PS[3,1] ^ PS[5,1]) goto inst_next; goto [REL8];} # N xor V =0
:BLT  REL8			is op_h=5 & REL8 {if !(PS[3,1] ^ PS[5,1]) goto inst_next; goto [REL8];} # N xor V =1
:BGT  REL8			is op_h=6 & REL8 {if ((PS[3,1] ^ PS[5,1])|PS[2,1]) goto inst_next; goto [REL8];} # (N xor V) or Z =0
:BLE  REL8			is op_h=7 & REL8 {if !((PS[3,1] ^ PS[5,1])|PS[2,1]) goto inst_next; goto [REL8];} # (N xor V) or Z =0
:BHI  REL8			is op_h=0x82 & REL8 {if !(!PS[0,1] | !PS[2,1]) goto inst_next; goto [REL8];} # C or Z =0
:BLOS REL8			is op_h=0x83 & REL8 {if !(PS[0,1] | PS[2,1]) goto inst_next; goto [REL8];} # C or Z =1

