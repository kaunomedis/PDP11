:ASH OPD,reg_s	is (kodas_s=7 &met_s=2 & reg_s) ...& OPD {
cnt:2 = OPD & 0x3F;
old:2 = reg_s;
mag:2 = 0;
if (cnt==0) goto <zero>;
if ((cnt & 0x20)!=0) goto <right>;

mag = cnt;
C = (((old << (mag-1)) & 0x8000)!=0);
reg_s = reg_s << mag;
goto <done>;

<right>
mag = (0x40 - cnt) & 0x3F;
C = (((old s>> (mag-1)) & 1)!=0);
reg_s = reg_s s>> mag;
goto <done>;

<zero>
V=0;
goto <flags>;

<done>
V = (((old ^ reg_s) & 0x8000)!=0);

<flags>
FLN(reg_s); FLZ(reg_s);
}


:ASHC OPD,reg_s	is (kodas_s=7 & met_s=3 & reg_s & reg_lo & reg_ss) ... & OPD {
cnt:2 = OPD & 0x3F;
mag:2 = 0;
rot:2 = 0;
cbit:2 = 0;
old:4 = (zext(reg_s)<<16) | zext(reg_lo);
comb:4 = old;
oldw:2 = reg_s;
oddreg:2 = reg_ss;

if (cnt==0) goto <zero>;
if ((cnt & 0x20)!=0) goto <right>;

# ---- LEFT shift: normal 32-bit arithmetic shift ----
mag = cnt;
C = (((old << (mag-1)) & 0x80000000)!=0);
comb = old << mag;
goto <finish32>;

<right>
mag = (0x40 - cnt) & 0x3F;
if ((oddreg & 1)!=0) goto <right_odd>;

# ---- RIGHT shift, even register pair: normal 32-bit arithmetic shift ----
C = (((old s>> (mag-1)) & 1)!=0);
comb = old s>> mag;
goto <finish32>;

<right_odd>
# ---- RIGHT shift, odd register: becomes a 16-bit rotate of that single register ----
rot = mag & 0xF;
cbit = (mag-1) & 0xF;
C = (((oldw >> cbit) & 1)!=0);
reg_s = (oldw >> rot) | (oldw << (16-rot));
N = (reg_s s< 0);
Z = (reg_s == 0);
V = (((oldw ^ reg_s) & 0x8000)!=0);
goto <end>;

<zero>
N = (old s< 0);
Z = (old == 0);
V = 0;
goto <end>;

<finish32>
reg_s  = comb(2);
reg_lo = comb(0);
N = (comb s< 0);
Z = (comb == 0);
V = (((old ^ comb) & 0x80000000)!=0);

<end>
}
##################################################################################

:MOV OPS,OPD 	is (kodas_s=0x1)...& OPD & OPS {N=((OPS & 0x8000)!=0);FLZ(OPS); OPD = OPS; V=0;}
:MOVB OPS,OPD 	is (kodas_s=0x9)...& OPD & OPS {OPD=OPD & 0xFF00; OPD =OPD | (OPS & 0x00FF); FLZ(OPS & 0x00FF);}
:CMP OPS,OPD 	is (kodas_s=0x2)... & OPD & OPS {CMP_FLAGS(OPD,OPS);}
:CMPB OPS,OPD 	is (kodas_s=0xA)... & OPD & OPS {CMP_FLAGS(OPD<<8,OPS<<8); FLZ((OPD&0xFF)==(OPS&0xFF));}
:SUB OPS,OPD 	is (kodas_s=0xE)... & OPS & OPD {SUB_FLAGS(OPS,OPD); OPD=OPD-OPS;FLN(OPD);}
:ADD OPS,OPD 	is (kodas_s=0x6)... & OPS & OPD {ADD_FLAGS(OPS,OPD);OPD=OPD+OPS;FLN(OPD);}

:BIT OPS,OPD 	is (kodas_s=0x3)... & OPS & OPD {tmp:2=OPS&OPD;FLN(tmp);FLZ(tmp);V=0;}
:BITB OPS,OPD 	is (kodas_s=0xB)... & OPS & OPD {tmp:2=OPS&OPD;FLN(tmp<<8);FLZ(tmp&0xFF);V=0;}
:BIC OPS,OPD 	is (kodas_s=0x4)... & OPS & OPD {OPD=(~OPS) & OPD;FLZ(OPD);FLN(OPD); V=0;} #bit clear dst=not(src) and (dst)
:BICB OPS,OPD 	is (kodas_s=0xC)... & OPS & OPD {tmp=OPD&0xFF00;OPD=((~OPS)&0x00FF)|tmp;FLZ(OPD&0x00FF);FLN(OPD<<8); V=0;}
:BIS OPS,OPD 	is (kodas_s=0x5)... & OPS & OPD {OPD=OPD | OPS; FLN(OPD);FLZ(OPD);V=0;}
:BISB OPS,OPD 	is (kodas_s=0xD)... & OPS & OPD {OPD=OPD | (OPS&0xFF); FLN(OPD);FLZ(OPD);V=0;}
:INC OPD		is (kodas_s=0 & met_s=5 &reg_s=2)... &OPD {V=(OPD==0x7FFF);OPD=OPD+1; FLZ(OPD);FLN(OPD);}
:INCB OPD		is (kodas_s=8 & met_s=5 &reg_s=2)... &OPD {V=(OPD==0x7F);tmp=OPD & 0xFF00; OPD=((OPD+1)&0x00FF)|tmp; FLZ(OPD & 0xFF00); FLN(OPD<<8);}
:CLR OPD		is (kodas_s=0 & met_s=5 &reg_s=0)... &OPD {OPD=0; N=0; Z=1; V=0; C=0;}
:CLRB OPD		is (kodas_s=8 & met_s=5 &reg_s=0)... &OPD {OPD=OPD & 0xFF00; N=0; Z=1; V=0; C=0;}

:COM OPD		is (kodas_s=0 & met_s=5 &reg_s=1)... &OPD {OPD=~OPD; FLZ(OPD);FLN(OPD); V=0; C=1;}
:COMB OPD		is (kodas_s=8 & met_s=5 &reg_s=1)... &OPD {tmp=OPD&0xFF00;OPD=((~OPD)&0x00FF)|tmp;FLZ(OPD&0x00FF);FLN(OPD<<8); V=0; C=1;}
:DEC OPD		is (kodas_s=0 & met_s=5 &reg_s=3)... &OPD {V=(OPD==0x8000);OPD=OPD-1;FLZ(OPD);FLN(OPD);}
:DECB OPD		is (kodas_s=8 & met_s=5 &reg_s=3)... &OPD {tmp0:2=OPD&0xFF00;OPD=OPD&0xFF;V=(OPD==0x80);OPD=(OPD-1)&0xFF;FLZ(OPD);FLN(OPD<<8);OPD=OPD|tmp0;}

:NEG OPD		is (kodas_s=0 & met_s=5 &reg_s=4)... &OPD {OPD=-OPD; FLZ(OPD); FLV(OPD);FLN(OPD);C=(OPD!=0);}

:NEGB OPD		is (kodas_s=8 & met_s=5 &reg_s=4)... &OPD {tmp0=OPD&0xFF00;OPD=(0-OPD)&0xFF;V=(OPD==0x80);FLZ(OPD);FLN(OPD<<8);C=(OPD!=0);OPD=OPD|tmp0;}
:ADC OPD		is (kodas_s=0 & met_s=5 &reg_s=5)... &OPD {tmp:2=OPD+(PS&1);V=1;if((OPD==0x7FFF)&((PS&1)==1))goto<a>;V=0;<a>C=1;if((OPD==0xFFFF)&((PS&1)==1))goto<b>;C=0;<b>OPD=tmp;FLZ(OPD);FLN(OPD);}
:ADCB OPD		is (kodas_s=8 & met_s=5 &reg_s=5)... &OPD {tmp0:2=OPD&0xFF00;tmp:2=(OPD&0xFF)+(PS&1);V=1;OPD=OPD&0xFF;if((OPD==0x7F)&((PS&1)==1))goto<a>;V=0;<a>C=1;if((OPD==0xFF)&((PS&1)==1))goto<b>;C=0;<b>OPD=tmp;FLZ(OPD);FLN(OPD<<8);OPD=OPD|tmp0;}

:SBC OPD		is (kodas_s=0 & met_s=5 &reg_s=6)... &OPD {tmp=OPD-(PS&1);V=(OPD+(PS&1)==0x8001);C=(OPD-(PS&1)==0xFFFF);OPD=tmp;FLN(OPD);FLZ(OPD);}
:SBCB OPD		is (kodas_s=8 & met_s=5 &reg_s=6)... &OPD {tmp0=OPD&0xFF00;OPD=OPD&0xFF;tmp=OPD-(PS&1);V=(OPD+(PS&1)==0x81);C=(OPD-(PS&1)==0xFF);OPD=tmp;FLN(OPD<<8);FLZ(OPD);OPD=OPD|tmp0;}

:ROR OPD		is (kodas_s=0 & met_s=6 &reg_s=0)... &OPD {tmp:2=OPD & 1;tmp2:2=0;OPD=OPD>>1;if !(C) goto <c>;tmp2=0x8000;<c>C=0;OPD=OPD | tmp2;PS=PS|tmp;FLZ(OPD); FLN(OPD);V_NZ();}
:RORB OPD		is (kodas_s=8 & met_s=6 &reg_s=0)... &OPD {tmp:2=(OPD&0xFF00)|((PS&1)<<7);C=0;PS=PS|(OPD&1);OPD=((OPD&0x00FF)>>1)|tmp;FLZ(OPD&0x00FF);FLN(OPD<<8);V_NZ();}
:ROL OPD		is (kodas_s=0 & met_s=6 &reg_s=1)... &OPD {tmp:2=OPD>>15;OPD=(OPD<<1)|(PS & 1);C=0;PS=PS|tmp;FLZ(OPD);FLN(OPD);V_NZ();}
:ROLB OPD		is (kodas_s=8 & met_s=6 &reg_s=1)... &OPD {tmp0:2=OPD&0xFF00;OPD=OPD&0xFF;tmp:2=OPD>>7;OPD=(OPD<<1)|(PS & 1);C=0;PS=PS|tmp;FLZ(OPD);FLN(OPD<<8);V_NZ();OPD=OPD|tmp0;}
:ASR OPD		is (kodas_s=0 & met_s=6 &reg_s=2)... &OPD {tmp:2=OPD & 0x8000;C=(OPD & 1)==1;OPD=(OPD>>1) | tmp;FLZ(OPD);FLN(OPD);V_NZ();}
:ASRB OPD		is (kodas_s=8 & met_s=6 &reg_s=2)... &OPD {tmp=OPD&0xFF80;C=0;PS=PS|(OPD&1);OPD=(OPD>>1)|tmp;FLZ(OPD&0x00FF);FLN(OPD<<8);V_NZ();}
:ASL OPD		is (kodas_s=0 & met_s=6 &reg_s=3)... &OPD {C=(OPD & 0x8000)!=0;OPD=OPD<<1;FLZ(OPD); FLN(OPD); V_NZ();}

:ASLB OPD		is (kodas_s=8 & met_s=6 &reg_s=3)... &OPD {C=(OPD & 0x0080)!=0;tmp=OPD&0xFF00;OPD=(OPD&0x007F)<<1;FLZ(OPD);FLN(OPD<<8); V_NZ();OPD=OPD|tmp;}
:TST OPD		is (kodas_s=0 & met_s=5 &reg_s=7)... &OPD {FLZ(OPD); V=0; C=0; FLN(OPD);}
:TSTB OPD		is (kodas_s=8 & met_s=5 &reg_s=7)... &OPD {FLZ(OPD & 0x00FF); V=0; C=0; FLN(OPD<<8);}
:SXT OPD		is (kodas_s=0 & met_s=6 &reg_s=7)... &OPD {tmp=0xFFFF;if (N) goto <b>;tmp=0;<b>OPD=tmp;}
:SWAB OPD		is (kodas_s=0 & met_s=0 &reg_s=3)... &OPD {tmp=OPD>>8; OPD=(OPD<<8)|tmp;FLN(OPD<<8);FLZ(OPD&0xFF);V=0;C=0;}
#:MFPS OPD		is (kodas_s=8 & met_s=6 &reg_s=7)... &OPD {tmp=sext(PS[0,8]);OPD=PS&0xFF|tmp;FLZ(OPD&0xFF);V=0;N=((OPD&0x80)==0x80);}

:MFPS OPD		is (kodas_s=8 & met_s=6 & reg_s=7 & met_d=0)... &OPD {tmp=sext(PS[0,8]);OPD=PS&0xFF|tmp;FLZ(OPD&0xFF);V=0;N=((OPD&0x80)==0x80);}
:MFPS OPD		is (kodas_s=8 & met_s=6 & reg_s=7 & met_d!=0)... &OPD {OPD=(OPD&0xFF00)|(PS&0xFF);FLZ(PS&0xFF);V=0;N=((PS&0x80)==0x80);}








:MTPS OPD		is (kodas_s=8 & met_s=6 & reg_s=4)... &OPD {PS=(PS&0xFF10)|(OPD&0xEF);}

#:MTPS OPD		is (kodas_s=8 & met_s=6 & reg_s=4)... &OPD {tmp=OPD&0b01010101;PS=PS&(~0b01010101)|tmp;}
############################################################################################

# Jumpai (PC registras, R7)
#          543210
# 2 - #X   010 111 = 17
# 3 - @#X  011 111 = 1f
# 6 - X    110 111 = 37
# 7 - @X   111 111 = 3f

# JMP - jumps. Some of these make no sense, but are legal. Or semi-legal.
:JMP ""reg_d" ok0" 		is kodas_s=0 & met_s=0 & reg_s=1 & met_d=0 & reg_d {PC=reg_d; goto reg_d;} #OK
:JMP "("reg_d") ok1" 	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=1 & reg_d {PC=reg_d; goto [PC];} #OK
:JMP "#"imm16" ok2a"	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=2 & reg_d=7; imm16 {PC=imm16; goto [PC];}
:JMP "("reg_d")+ ok2b"	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=2 & reg_dd!=7 & reg_d { PC=reg_d; reg_d=reg_d+2; goto [PC];}
:JMP "@#"imm16" ok3"	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=3 & reg_d=7; imm16 {PC=imm16; goto [PC];}

:JMP "@("reg_d")+ ok3b"	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=3 & reg_dd!=7 & reg_d {reg_d=reg_d+2; PC=reg_d-2; goto [PC];}


:JMP "-("reg_d") ok4" 	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=4 & reg_d {reg_d=reg_d-2; PC=reg_d; goto [PC];} #OK
# met_d=5
:JMP REL16 "ok6"		is kodas_s=0 & met_s=0 & reg_s=1 & met_d=6 & reg_d=7 ; REL16{PC=REL16; goto [PC];}
:JMP "@"REL16" ok7" 	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=7 & reg_d=7; REL16 {goto [REL16];}

:JMP imm16(reg_d)"ok7b" is kodas_s=0 & met_s=0 & reg_s=1 & met_d=7 & reg_dd!=7 &reg_d; imm16 {tmp:2=imm16+reg_d;goto [tmp];}



:JMP REL16(reg_d)	is kodas_s=0 & met_s=0 & reg_s=1 & met_d=6 & reg_dd!=7 & reg_d; REL16 {goto [REL16];} #???
# JSR methods.
I16: imm16	is imm16 {export *:2 imm16;}

:JSRa reg_s,(reg_d)	is  kodas_s=0 & met_s=4 & reg_ss<7 &reg_dd!=7& met_d=1 & reg_s &reg_d {tmp:2=reg_d;push(reg_s);reg_s=PC+2;PC=tmp;call[PC];}
:JSRb reg_s,#I16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=1)& reg_s ;I16 {push(PC+2); tmp=reg_s+I16; call [tmp];}
:JSRc reg_s,#I16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=2)& reg_s ;I16 {push(PC+2); tmp=reg_s+I16; call [tmp];}
:JSRd reg_s,@#I16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=3)& reg_s ;I16 {push(PC+2); tmp=I16+reg_s; call [*:2 tmp];}
:JSRe reg_s,REL16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=6)& reg_s ;REL16 {push(PC+2); tmp=reg_s+REL16; call [*:2 tmp];}
:JSRf reg_s,@REL16	is (kodas_s=0 & met_s=4 & reg_ss<7 & reg_d=7 & met_d=7)& reg_s ;REL16 {push(PC+2); tmp=reg_s+REL16; call [*:2 tmp];}
:JSRg "PC?",OPD	is (kodas=0x27 & reg_d!=7)... & OPD {call OPD;}

:"ILLEGAL CALL 0>"REL16	is (kodas=0x27 & met_d=0 & reg_d=7) ; REL16 {push(PC+2); call [REL16]; }
:jsr reg_s,(reg_d)		is (kodas=0x27 & met_d=1 & reg_dd=7 & reg_d & reg_s) {push(PC+2); }
:CALL #I16				is (kodas=0x27 & met_d=2 & reg_d=7) ; I16 {push(PC+2);call [I16];}
:CALL @#I16				is (kodas=0x27 & met_d=3 & reg_d=7) ; I16 {push(PC+2);call I16; }
:"ILLEGAL CALL 4>"REL16	is (kodas=0x27 & met_d=4 & reg_d=7) ; REL16 {push(PC+2);call [REL16]; }
:"ILLEGAL CALL 5>"REL16	is (kodas=0x27 & met_d=5 & reg_d=7) ; REL16 {push(PC+2);call [REL16]; }
:CALL REL16				is (kodas=0x27 & met_d=6 & reg_d=7) ; REL16 {push(PC+2); call [REL16]; }
:CALL "@"REL16			is (kodas=0x27 & met_d=7 & reg_d=7) ; REL16 {push(PC+2); call [REL16]; }

###### RETURN
:RETURN		is imm16=0x87 {pop(PC);return [PC];}
:RTS reg_d	is kodas=2 & metod=0 & regai<7 &reg_d {PC=reg_d;pop(reg_d);return [PC];}

:MARK nnn is kodas=0x34 &nnn {SP=PC+2*nnn;PC=R5;pop(R5);} # SP := PC + 2 * NN; PC := R5; R5 := (SP)+

:SPL reg_dd is kodas=2 & metod=3 & reg_dd {PC=PC; SPLevel=reg_dd;} #set priority level?

######## FPU FPU FPU #########################
FRD: reg_d is reg_d			{ export *:1 reg_d; }
:FADD FRD	is fpu=0b0111101000000 & FRD {PC=PC;}
:FSUB FRD	is fpu=0b0111101000001 & FRD {PC=PC;}
:FMUL FRD	is fpu=0b0111101000010 & FRD {PC=PC;}
:FDIV FRD	is fpu=0b0111101000011 & FRD {PC=PC;}

############ nezinoma fpu

:ldcfd OPD,"f1"		is (op_h=0b11111111  &ac=0)... &OPD{PC=PC;}
:ldcfd OPD,"f2"		is (op_h=0b11111111  &ac=1)... &OPD{PC=PC;}
:ldcfd OPD,"f3"		is (op_h=0b11111111  &ac=2)... &OPD{PC=PC;}
:divfd OPD,"f1"		is (op_h=0b11111001  &ac=0)... &OPD{PC=PC;}
:divfd OPD,"f2"		is (op_h=0b11111001  &ac=1)... &OPD{PC=PC;}
:divfd OPD,"f3"		is (op_h=0b11111001  &ac=2)... &OPD{PC=PC;}
:cmpfd OPD,"f1"		is (op_h=0b11110111  &ac=0)... &OPD{PC=PC;}
:cmpfd OPD,"f2"		is (op_h=0b11110111  &ac=1)... &OPD{PC=PC;}
:cmpfd OPD,"f3"		is (op_h=0b11110111  &ac=2)... &OPD{PC=PC;}
:ldcifd OPD,"f1"	is (op_h=0b11111110  &ac=0)... &OPD{PC=PC;}
:ldcifd OPD,"f2"	is (op_h=0b11111110  &ac=1)... &OPD{PC=PC;}
:ldcifd OPD,"f3"	is (op_h=0b11111110  &ac=2)... &OPD{PC=PC;}
:ldexp OPD,"f1"		is (op_h=0b11111101  &ac=0)... &OPD{PC=PC;}
:ldexp OPD,"f2"		is (op_h=0b11111101  &ac=1)... &OPD{PC=PC;}
:ldexp OPD,"f3"		is (op_h=0b11111101  &ac=2)... &OPD{PC=PC;}
:ldfd OPD,"f1"		is (op_h=0b11110101  &ac=0)... &OPD{PC=PC;}
:ldfd OPD,"f2"		is (op_h=0b11110101  &ac=1)... &OPD{PC=PC;}
:ldfd OPD,"f3"		is (op_h=0b11110101  &ac=2)... &OPD{PC=PC;}
:modfd OPD,"f1"		is (op_h=0b11110011  &ac=0)... &OPD{PC=PC;}
:modfd OPD,"f2"		is (op_h=0b11110011  &ac=1)... &OPD{PC=PC;}
:modfd OPD,"f3"		is (op_h=0b11110011  &ac=2)... &OPD{PC=PC;}
:mulfd OPD,"f1"		is (op_h=0b11110010  &ac=0)... &OPD{PC=PC;}
:mulfd OPD,"f2"		is (op_h=0b11110010  &ac=1)... &OPD{PC=PC;}
:mulfd OPD,"f3"		is (op_h=0b11110010  &ac=2)... &OPD{PC=PC;}
:negfd OPD,"f1"		is (op_h=0b11000111  &ac=0)... &OPD{PC=PC;}
:negfd OPD,"f2"		is (op_h=0b11000111  &ac=1)... &OPD{PC=PC;}
:negfd OPD,"f3"		is (op_h=0b11000111  &ac=2)... &OPD{PC=PC;}
:stcfd OPD,"f1"		is (op_h=0b11111100  &ac=0)... &OPD{PC=PC;}
:stcfd OPD,"f2"		is (op_h=0b11111100  &ac=1)... &OPD{PC=PC;}
:stcfd OPD,"f3"		is (op_h=0b11111100  &ac=2)... &OPD{PC=PC;}
:stfd OPD,"f1"		is (op_h=0b11111000  &ac=0)... &OPD{PC=PC;}
:stfd OPD,"f2"		is (op_h=0b11111000  &ac=1)... &OPD{PC=PC;}
:stfd OPD,"f3"		is (op_h=0b11111000  &ac=2)... &OPD{PC=PC;}

:ccfc is imm16=0xf000 {PC=PC;}
:setf is imm16=0xf001 {PC=PC;}
:seti is imm16=0xf002 {PC=PC;}

:setd is imm16=0xf009 {PC=PC;}
:setl is imm16=0xf00a {PC=PC;}





