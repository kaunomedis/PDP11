# WARNING! ALL STUFF in {} is untested.

define endian=little;
define alignment=2;

define space ram      type=ram_space      size=2 default; # would like to have 3, but errors...
define space register type=register_space size=2;

# R0–R7 (SP=R6, PC=R7)
define register offset=0x0000 size=2 [ R0 ];
define register offset=0x0002 size=2 [ R1 ];
define register offset=0x0004 size=2 [ R2 ];
define register offset=0x0006 size=2 [ R3 ];
define register offset=0x0008 size=2 [ R4 ];
define register offset=0x000A size=2 [ R5 ];
define register offset=0x000C size=2 [ SP ]; #R6 , stekas mazejantis
define register offset=0x000E size=2 [ PC ]; #R7
define register offset=0x0020 size=2 [ PS ]; # STATUS FLAGS & INT LEVEL

# Flag Register Contents (PS)
#
# b15:14    - Current mode: 00-kernel, 01-supervisor, 10-illegal, 11-user
# b13:b12   - Previous mode
# b11		- register set
# b10:b9	- unused
# b8   		- Reserved area
# b7        - (I) Interrupt prio 
# b6        - (I) Interrupt prio
# b5        - (I) Interrupt prio 
# b4        - (T) trace
# b3        - (S)(N) Sign flag
# b2        - (Z) Zero flag
# b1        - (O)(V) Overflow flag 
# b0        - (C) Carry flag

define bitrange
SPLevel=PS[5,3]

# U = PS[7,1]
# I = PS[6,1]
# D = PS[5,1]


# T = PS[4,1]

N = PS[3,1]
S = PS[3,1]
Z = PS[2,1]
V = PS[1,1]
O = PS[1,1]
C = PS[0,1]
;


macro CHKNZ(a){N=(a & 0x8000)!=0;Z=(a==0);}
macro V_NZ(){V=C ^ N;}

macro ADD_FLAGS(ss,dd){ts=(ss & 0x8000)!=0;td=(dd & 0x8000)!=0;tr=(((ss+dd) & 0x8000)!=0);Z=(ss==dd);V=((!(ts ^ td)) & (tr ^ td));C=((ts & td)|(ts ^ td) & !tr);}
macro SUB_FLAGS(ss,dd){ts=(ss & 0x8000)!=0;td=(dd & 0x8000)!=0;tr=(((ss-dd) & 0x8000)!=0);Z=(ss==dd);V=((ts ^ td) & (!(tr ^ td)));C=((ts & !(td))|(!(ts ^ td) & tr));N=(dd>ss);}
macro CMP_FLAGS(ss,dd){ts=(ss & 0x8000)!=0;td=(dd & 0x8000)!=0;tr=(((ss-dd) & 0x8000)!=0);Z=(ss==dd);V=((ts ^ td) & (!(tr ^ td)));C=(((!ts) & td)|(!(ts ^ td) & tr));N=(dd>ss);}
macro FLZ(register){Z=(register==0);}
macro FLV(register){V=((register & 0xFFFF)==0xFFFF);}
macro FLN(register){N=(register & 0x8000)!=0;}

macro push(val) {SP = SP - 2;*:2 SP = val;}
macro pop(val)  {val = *:2 SP;SP = SP + 2;}

#TOKENS

# main opcode
define token word_1 (16)
	byte = (15,15)
	kodas = (6,15)
	metod = (3,5)
	regai =(0,2)
	
	op_h =(8,15)
	ac=(6,7)
	rell = (0,7) signed
	baitas = (0,7)
	eemt=(0,7)
	
	kodas_s = (12,15)
	met_s=(9,11)
	reg_s=(6,8)
	reg_ss=(6,8)
	reg_lo=(6,8)	
	
	met_d=(3,5)
	
	reg_d=(0,2)
	reg_dd=(0,2)

	
	nnn=(0,5)
	fpu=(3,15)
	
;

attach variables [ reg_s] [ R0 R1 R2 R3 R4 R5 SP PC];
attach variables [ reg_d] [ R0 R1 R2 R3 R4 R5 SP PC];
attach variables [ reg_lo ] [ R1 R1 R3 R3 R5 R5 PC PC];

# next word with data or first opcode
define token data_word (16)
	imm16 = (0,15)
	rell16	=(0,15) signed
;

# THIS HACK. I do not know how to use two imm16, two words of data (4 bytes)
define token data_double_word (32)
	imm32=(0,31)
	imm32H=(16,31)
	rell32h=(16,31) signed
	imm32L=(0,15)
	rell32l=(0,15) signed
;
# Relative addressing. Note x2 multiplication (adressing is in words)
REL8:	reloc	is rell			[reloc = inst_next + 2 * rell;]	{ tmp:2 = 0; tmp=reloc; export  tmp;} 
# relative values from extra bytes.
REL32H:	reloc 	is rell32h  	[reloc = inst_next + rell32h;]	{ tmp:2 = 0; tmp=reloc; export  tmp; } 
REL32L:	reloc 	is rell32l  	[reloc = inst_next + rell32l-2;]	{tmp:2 = 0; tmp=reloc; export  tmp; } 
REL16:	reloc	is rell16   	[reloc = inst_next + rell16;]	{tmp:2 = 0; tmp=reloc; export  tmp; }
RELN:	reloc	is nnn	[reloc = inst_next-nnn*2;]		{tmp:2 = 0; tmp=reloc; export  tmp; } 

# ############# SIMPLE INSTRUCTIONS #################################### 
:MFPT		is imm16=0x07	{R0=R0;}
:EMHALT		is imm16=0x08	{R0=R0;}
:NOP		is imm16=0x0A0	{R0=R0;}
:HALT		is imm16=0		{tmp:2=0x28; PC=*:2 tmp; tmp=0x2A; PS=*:2 tmp; goto [PC];}
:WAIT		is imm16=1		{PC=PC-2; goto [PC];}
:CLC		is imm16=0x0A1	{C=0;}
:CLV		is imm16=0x0A2	{V=0;}
:CLVC		is imm16=0x0A3	{C=0;V=0;}
:CLZ		is imm16=0x0A4	{Z=0;}
:CLZC		is imm16=0x0A5	{Z=0;C=0;}
:CLZV		is imm16=0x0A6	{Z=0;V=0;}
:CLZVC		is imm16=0x0A7	{Z=0;V=0;C=0;}
:CLN		is imm16=0x0A8	{N=0;}
:CCC		is imm16=0x0AF	{C=0;V=0;Z=0;N=0;}

:SEC		is imm16=0x0b1	{C=1;}
:SEV		is imm16=0x0b2	{V=1;}
:SEVC		is imm16=0x0b3	{V=1;C=1;}
:SEZ		is imm16=0x0b4	{Z=1;}
:SEZC		is imm16=0x0b5	{Z=1;C=1;}
:SEZV		is imm16=0x0b6	{Z=1;V=1;}
:SEZVC		is imm16=0x0b7	{Z=1;C=1;V=1;}

:SEN		is imm16=0x0b8	{N=1;}
:SENC		is imm16=0x0b9	{N=1;C=1;}
:SENV		is imm16=0x0ba	{N=1;V=1;}
:SENVC		is imm16=0x0bb	{N=1;V=1;C=1;}
:SENZ		is imm16=0x0bc	{N=1;Z=1;}
:SENZC		is imm16=0x0bd	{N=1;Z=1;C=1;}
:SENZV		is imm16=0x0be	{N=1;V=1;Z=1;}

:CSM		is imm16=0xe40	{PC=PC;}

:SCC		is imm16=0x0bF {C=1;V=1;Z=1;N=1;}
:EMT "[#"baitas"]"		is op_h=0x88 & baitas { push(PS); push(PC); PC=(0x18);PS=(0x1A); call [PC];} # NETEISYBE

:EMT "[#"eemt"] .PRINT"			is op_h=0x88 & baitas=0xE9 & eemt { push(PS); push(PC); PC=(0x18);PS=(0x1A); call [PC];} # NETEISYBE
:EMT "[#"eemt"] .EXIT"			is op_h=0x88 & baitas=0xE8 & eemt { push(PS); push(PC); PC=(0x18);PS=(0x1A); call [PC];} # NETEISYBE
:EMT "[#"eemt"] .TTY_IN"		is op_h=0x88 & baitas=0xE0 & eemt { push(PS); push(PC); PC=(0x18);PS=(0x1A); call [PC];} # NETEISYBE
:EMT "[#"eemt"] .TTY_OUT"		is op_h=0x88 & baitas=0xE1 & eemt { push(PS); push(PC); PC=(0x18);PS=(0x1A); call [PC];} # NETEISYBE
:EMT "[#"eemt"] .I/O page op"	is op_h=0x88 & baitas=0xFD & eemt { push(PS); push(PC); PC=(0x18);PS=(0x1A); call [PC];} # NETEISYBE


:TRAP		is op_h=0x89	{push(PS); push(PC); tmp:2=0x1c; PC=*:2 tmp; tmp=0x1e; PS=*:2 tmp; call [PC];} # NETEISYBE
:IOT		is imm16=0x004	{push(PS); push(PC); PC=(0x10); PS=(0x12); call [PC];} # NETEISYBE
:BPT		is imm16=0x003	{push(PS); push(PC); PC=(0x0C); PS=(0x0E); call [PC];} # NETEISYBE
:RTI		is imm16=0x002	{pop(PC); pop(PS); return [PC];} # NETEISYBE
:RTT		is imm16=0x006	{pop(PC); pop(PS); return [PC];} # NETEISYBE
:RESET		is imm16=0x005	{SP=SP;}

:BR   REL8			is op_h=1 & REL8	{goto [REL8];}
:BNE  REL8			is op_h=2 & REL8	{if Z	goto inst_next; goto [REL8];} # Z=0
:BEQ  REL8			is op_h=3 & REL8	{if !Z	goto inst_next; goto [REL8];} # Z=1
:BPL  REL8			is op_h=0x80 & REL8 {if N	goto inst_next; goto [REL8];} # N=0 sign
:BMI  REL8			is op_h=0x81 & REL8 {if !N	goto inst_next; goto [REL8];} # N=1
:BVC  REL8			is op_h=0x84 & REL8 {if V	goto inst_next; goto [REL8];} # V=0 overflow
:BVS  REL8			is op_h=0x85 & REL8 {if !V	goto inst_next; goto [REL8];} # V=1
:BCC  REL8			is op_h=0x86 & REL8 {if C	goto inst_next; goto [REL8];} # C=0 carry
:BCS  REL8			is op_h=0x87 & REL8 {if !C	goto inst_next; goto [REL8];} # C=1
:BGE  REL8			is op_h=4 & REL8	{if (N ^ V)		goto inst_next; goto [REL8];} # N xor V =0
:BLT  REL8			is op_h=5 & REL8	{if !(N ^ V)	goto inst_next; goto [REL8];} # N xor V =1
:BGT  REL8			is op_h=6 & REL8	{if ((N ^ V)|Z)	goto inst_next; goto [REL8];} # (N xor V) or Z =0
:BLE  REL8			is op_h=7 & REL8	{if !((N ^ V)|Z)goto inst_next; goto [REL8];} # (N xor V) or Z =0
:BHI  REL8			is op_h=0x82 & REL8 {if !(!C | !Z)	goto inst_next; goto [REL8];} # C or Z =0
:BLOS REL8			is op_h=0x83 & REL8 {if !(C | Z)	goto inst_next; goto [REL8];} # C or Z =1

