//Watches PDP-11 ODT UART TX register and prints characters when emulator writes to it.
//@author 
//@category PDP11 Hardware
//@runtime Java

import ghidra.app.script.GhidraScript;
import ghidra.app.emulator.EmulatorHelper;
import ghidra.program.model.address.Address;
import ghidra.util.task.TaskMonitor;

public class Copilot_ODT extends GhidraScript {

    private static final long ODT_UART_TX = 0177566;   // DL11 TX register

    @Override
    public void run() throws Exception {

        println("PDP-11 ODT UART watcher (Ghidra 11.2.1)");

        EmulatorHelper emu = new EmulatorHelper(currentProgram);

        Address uartAddr = currentProgram.getAddressFactory()
                .getDefaultAddressSpace()
                .getAddress(ODT_UART_TX);

        byte[] buf = new byte[1];
        byte last = -1;
	


        while (!monitor.isCancelled()) {

            // Step one instruction
            emu.step(monitor);

            // Read 1 byte from UART TX register

		 buf = emu.readMemory(toAddr(0xFF76), 1);

            byte current = buf[0];

            // Detect change
           // if (current != last) {
                char ch = (char)(current & 0xff);
              //  println("UART: " + ch);
println("UART HEX: " + String.format("%02X", current & 0xFF));

                last = current;
           // }
        }

        println("UART watcher stopped.");
    }
}

